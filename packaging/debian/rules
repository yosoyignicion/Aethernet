#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	install -D -m 0644 packaging/aethernet.desktop \
		debian/aethernet/usr/share/applications/aethernet.desktop
	install -D -m 0644 packaging/aethernet.service \
		debian/aethernet/usr/lib/systemd/user/aethernet.service
