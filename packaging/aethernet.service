[Unit]
Description=Aethernet RF monitor (daemon de vigilancia pasiva)
Documentation=file:%h/.local/share/aethernet/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Unidad de USUARIO: se instala en ~/.config/systemd/user/ y usa binarios del usuario.
ExecStart=%h/.local/bin/aethernet daemon run
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10
# El daemon no necesita privilegios para escaneos gestionados.
# El MONITOR PASIVO sí requiere CAP_NET_ADMIN/CAP_NET_RAW:
#   - opción simple:   sudo -E aethernet monitor start
#   - o un servicio de sistema con AmbientCapabilities (ver docs/ROADMAP.md).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=default.target
